enable
configure terminal
hostname GRE-SW03

vlan 100
 name GERENCIA
exit
vlan 200
 name PRODUCCION
exit
vlan 300
 name VENTAS
exit
vlan 400
 name DESARROLLO
exit
vlan 900
 name ADMIN-SSH
exit

interface range FastEthernet0/1-16
 description ACCESO-DESARROLLO
 switchport mode access
 switchport access vlan 400
!
interface range FastEthernet0/17-24
 description ACCESO-GERENCIA
 switchport mode access
 switchport access vlan 100
!
interface GigabitEthernet0/1
 description TRUNK-A-GRE-SW02
 switchport mode trunk
 switchport trunk native vlan 100
!
interface GigabitEthernet0/2
 description SIN-USO-PENDIENTE-SHUTDOWN-FASE5
!
interface Vlan900
 description MGMT-VLAN900
 ip address 172.27.86.116 255.255.255.248
 no shutdown
!
ip default-gateway 172.27.86.113

end
write memory
